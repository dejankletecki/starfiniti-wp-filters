msgstr "Listanje mora biti pages, more ili infinite."

msgid "Filters must be a list."
msgstr "Filtri moraju biti popis."

msgid "Each filter must be an object with a source."
msgstr "Svaki filtar mora biti objekt s izvorom."

#. translators: %s: filter source, for example product_cat.
msgid "The filter \"%s\" is listed twice."
msgstr "Filtar »%s« naveden je dvaput."

#. translators: %s: what was given as the filter source.
msgid "\"%s\" is not a filter source."
msgstr "»%s« nije izvor filtra."

msgid "All products"
msgstr "Svi proizvodi"

msgid "Display"
msgstr "Prikaz"

#. translators: %s: filter name, for example Categories.
msgid "Display of the %s filter"
msgstr "Prikaz filtra %s"

msgid "Checkboxes"
msgstr "Potvrdni okviri"

msgid "Links to their own pages"
msgstr "Poveznice na vlastite stranice"

msgid "Product filters for the WooCommerce shop your theme already renders."
msgstr "Filtri proizvoda za WooCommerce trgovinu koju tema već prikazuje."

msgid "The update was not installed, because its checksum could not be read from GitHub. Try again later."
msgstr "Ažuriranje nije instalirano jer se kontrolni zbroj nije mogao pročitati s GitHuba. Pokušajte ponovno kasnije."

msgid "The update was not installed, because the downloaded file does not match its published checksum."
msgstr "Ažuriranje nije instalirano jer preuzeta datoteka ne odgovara objavljenom kontrolnom zbroju."

msgid "See the release on GitHub for details."
msgstr "Pojedinosti su u izdanju na GitHubu."

#. translators: %s: filter title, for example Length.
msgid "%s from"
msgstr "%s od"

#. translators: %s: filter title, for example Length.
msgid "%s to"
msgstr "%s do"

#. translators: 1: filter title, for example Length. 2: the chosen range, for example 30 cm – 120 cm.
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#. translators: %s: name of the category one level up.
msgid "Back to %s"
msgstr "Natrag na %s"

msgid "Links, one level at a time"
msgstr "Poveznice, razina po razina"

msgid "Show from"
msgstr "Prikaži od"

#. translators: %s: filter name, for example Colour.
msgid "Show the %s filter only when at least this percentage of the listed products has a value"
msgstr "Filtar %s prikaži samo kad barem ovoliki postotak prikazanih proizvoda ima vrijednost"

#. translators: %s: name of a category that has subcategories.
msgid "%s: subcategories"
msgstr "%s: potkategorije"

msgid "Slider and fields"
msgstr "Klizač i polja"

msgid "Ready-made ranges"
msgstr "Gotovi rasponi"

msgid "Swatches"
msgstr "Uzorci"

#. translators: %s: number of further values of a filter.
msgid "more (%s)"
msgstr "više (%s)"

msgid "less"
msgstr "manje"

msgid "Show first"
msgstr "Prikaži prvih"

#. translators: %s: filter name, for example Colour.
msgid "Show only this many values of the %s filter, the rest behind \"more\""
msgstr "Prikaži samo toliko vrijednosti filtra %s, ostale iza »više«"
